From 4a396d3503225c01a5afce20182e3887f2995fe4 Mon Sep 17 00:00:00 2001
From: Travis Cole <11240+kelp@users.noreply.github.com>
Date: Sun, 22 Nov 2026 10:57:07 -0800
Subject: [PATCH] eq: Headphones' long names end before Playing

A preset name too long for its row ran into the Playing mark. With
preset-name-ellipsis's NAME rows, it ends in an ellipsis short of it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DaXZzN3FY6RrXiA6e34J2b
---
 patch/peq_ui.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/patch/peq_ui.c b/patch/peq_ui.c
index 9da4c4e2..b86b01ab 100644
--- a/patch/peq_ui.c
+++ b/patch/peq_ui.c
@@ -236,8 +236,8 @@ static int action(void *ctx, void *event);
  * caption is of any length too (an OPRA preset's author), cut with an ellipsis where its value
  * starts, at x 166 as About's rows (navigation.c), past Rtings/AutoEQ's 112 px at x 36. NAME: a
  * caption of any length (a file's name), in an ellipsis label that scrolls while the row is
- * selected. */
-enum { DIM = 1, INTO = 2, SMALL = 4, LONG = 8, WIDE = 16, NAME = 32 };
+ * selected; beside a short value (Headphones' Playing) it ends NAME_VALUE px short of the row. */
+enum { DIM = 1, INTO = 2, SMALL = 4, LONG = 8, WIDE = 16, NAME = 32, NAME_VALUE = 80 };
 /* The curve's height in the list: whole rows of the theme's, so whole rows fill it at either
  * end. */
 static int graph_head(void) {
@@ -279,8 +279,9 @@ static void *row_dim(void *view, int index, const char *text, const char *value,
     void *wide = value && flags & WIDE ? long_value(item, value, rh, x) : 0;
     for (int i = 0; i < 1 + (value && !(flags & LONG)); ++i) {
         if (!i && flags & (WIDE | NAME)) {
-            label = hscroll_label_create(item, ROW_X, 0,
-                                         (flags & WIDE ? x - 4 : 375 - ROW_X) - ROW_X, rh);
+            int end =
+                flags & WIDE ? x - 4 : 375 - ROW_X - (value && !(flags & LONG) ? NAME_VALUE : 0);
+            label = hscroll_label_create(item, ROW_X, 0, end - ROW_X, rh);
             widget_use_style(label, "s_scrlabel_white20l");
             hscroll_label_set_only_focus(label, 1);
             hscroll_label_set_ellipses(label, 1);
@@ -1121,7 +1122,7 @@ static int render(const void *unused) {
                      ui.names[start + i]);
             snprintf(path, sizeof(path), PEQ_SAVED "/%s", ui.names[start + i]);
             int playing = !off && peq_load(path, &p) && same_filters(&p, &s.peq);
-            row_dim(view, n++, text, playing ? "Playing" : 0, i, 0);
+            row_dim(view, n++, text, playing ? "Playing" : 0, i, NAME);
         }
     } else {
         if (ui.screen == PRESETS) {
-- 
