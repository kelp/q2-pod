From 3429d2ff978b6db47c837f730bfc8f9f6d2ed2b4 Mon Sep 17 00:00:00 2001
From: Travis Cole <11240+kelp@users.noreply.github.com>
Date: Tue, 24 Nov 2026 19:52:49 -0800
Subject: [PATCH] eq: Headphones' long names end before Playing

upstream's NAME rows take the whole width, so a long preset name ran
into the Playing mark. Ported from the old fixup 0003.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DaXZzN3FY6RrXiA6e34J2b
---
 patch/peq_ui.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/patch/peq_ui.c b/patch/peq_ui.c
index 6767d5f0..a2dcbfcf 100644
--- a/patch/peq_ui.c
+++ b/patch/peq_ui.c
@@ -231,7 +231,7 @@ static int action(void *ctx, event_t *event);
  * value's if any. Rows start under the graph where it heads the list. WIDE: a LONG row whose
  * caption is of any length too (an OPRA preset's author), cut with an ellipsis where its value
  * starts, at x 166 as About's rows (navigation.c), past Rtings/AutoEQ's 112 px at x 36. */
-enum { DIM = 1, INTO = 2, SMALL = 4, LONG = 8, NAME = 16, WIDE = 32 };
+enum { DIM = 1, INTO = 2, SMALL = 4, LONG = 8, NAME = 16, WIDE = 32, NAME_VALUE = 80 };
 /* The curve's height in the list: whole rows of the theme's, so whole rows fill it at either
  * end. */
 static int graph_head(void) {
@@ -279,8 +279,10 @@ static widget_t *row_dim(widget_t *view, int index, const char *text, const char
             hscroll_label_set_ellipses(label, 1);
         } else if (flags & NAME) {
             /* a caption of any length (a file's name), in stock's ellipsis label as long_value's:
-             * its 2 px each side put its text in the plain label's box */
-            label = hscroll_label_create(item, ROW_X - 2, 0, 375 - 2 * ROW_X + 4, rh);
+             * its 2 px each side put its text in the plain label's box; beside a short value
+             * (Headphones' Playing) it ends NAME_VALUE px short of the row */
+            label = hscroll_label_create(item, ROW_X - 2, 0,
+                                         375 - 2 * ROW_X + 4 - (!i && value ? NAME_VALUE : 0), rh);
             widget_use_style(label, "s_scrlabel_white20l");
             hscroll_label_set_only_focus(label, 1);
             hscroll_label_set_ellipses(label, 1);
@@ -1175,7 +1177,7 @@ static int render(const void *unused) {
                      ui.names[start + i]);
             snprintf(path, sizeof(path), PEQ_SAVED "/%s", ui.names[start + i]);
             int playing = !off && peq_load(path, &p) && same_filters(&p, &s.peq);
-            row_dim(view, n++, text, playing ? tr("Playing") : 0, i, 0);
+            row_dim(view, n++, text, playing ? tr("Playing") : 0, i, NAME);
         }
     } else {
         if (ui.screen == PRESETS) {
